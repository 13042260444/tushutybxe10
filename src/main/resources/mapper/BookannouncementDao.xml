<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.BookannouncementDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.BookannouncementEntity" id="bookannouncementMap">
        <result property="title" column="title"/>
        <result property="picture" column="picture"/>
        <result property="publisher" column="publisher"/>
        <result property="introduction" column="introduction"/>
        <result property="content" column="content"/>
        <result property="clicktime" column="clicktime"/>
        <result property="storeupnum" column="storeupnum"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.BookannouncementVO" >
		SELECT * FROM bookannouncement  bookannouncement         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.BookannouncementVO" >
		SELECT  bookannouncement.* FROM bookannouncement  bookannouncement 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.BookannouncementView" >

		SELECT  bookannouncement.* FROM bookannouncement  bookannouncement 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.BookannouncementView" >
		SELECT * FROM bookannouncement  bookannouncement <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
