<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.UserDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.UserEntity" id="userMap">
        <result property="account" column="account"/>
        <result property="password" column="password"/>
        <result property="name" column="name"/>
        <result property="gender" column="gender"/>
        <result property="age" column="age"/>
        <result property="mobilephone" column="mobilephone"/>
        <result property="avatar" column="avatar"/>
        <result property="money" column="money"/>
        <result property="pquestion" column="pquestion"/>
        <result property="panswer" column="panswer"/>
        <result property="status" column="status"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.UserVO" >
		SELECT * FROM user  user         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.UserVO" >
		SELECT  user.* FROM user  user 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.UserView" >

		SELECT  user.* FROM user  user 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.UserView" >
		SELECT * FROM user  user <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
